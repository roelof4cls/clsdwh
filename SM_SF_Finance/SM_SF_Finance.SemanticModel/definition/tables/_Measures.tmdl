	/// Archived: use the Time Intelligence calculation group instead.
	measure 'Budget PY' = CALCULATE ( [Budget], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: Archive\Budget vs Actual
		lineageTag: fe8b33ad-d8e8-45d5-a966-1114cde397b0

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

	/// Archived: use the Time Intelligence calculation group instead.
	measure 'Budget YoY Variance %' =

			VAR PriorBudget = [Budget PY]
			RETURN
			    DIVIDE ( [Budget] - PriorBudget, ABS ( PriorBudget ) )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Archive\Budget vs Actual
		lineageTag: f1c226a4-5cc7-4d71-8b33-ebd2d74e155e

	/// Archived: use the Time Intelligence calculation group instead.
	measure 'Forecast PY' = CALCULATE ( [Forecast], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: Archive\Budget vs Actual
