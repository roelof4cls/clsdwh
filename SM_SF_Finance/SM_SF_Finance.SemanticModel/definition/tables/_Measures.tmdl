/// All model measures, grouped by subject area. Archive holds explicit time measures replaced by the Time Intelligence calculation group.
table _Measures
	lineageTag: 15cdb6b8-f506-4e6d-aaf6-a3815a5e3231

	/// Sum of credit amounts on general ledger lines.
	measure Credit = SUM ( 'General Ledger'[vCreditAmount] )
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: General Ledger
		lineageTag: 11877ec3-2620-465e-b4b9-34611fc686f5

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

	/// Sum of debit amounts on general ledger lines.
	measure Debit = SUM ( 'General Ledger'[vDebitAmount] )
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: General Ledger
		lineageTag: 794c2ece-3c6b-408f-841d-4edb931e4801

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

	/// Line amount plus tax.
	measure 'Total (VAT Incl)' = [Total (VAT Excl)] + [Tax]
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: General Ledger
		lineageTag: c18aa417-de2f-42f5-9d13-0a1c03c16e39

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

	/// Line amount excluding tax.
	measure 'Total (VAT Excl)' = SUM ( 'General Ledger'[vLineAmount] )
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: General Ledger
		lineageTag: d2f6bb45-3ee4-41f3-91a2-60cefee5f2ff

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

	/// Tax (VAT) amount on general ledger lines.
	measure Tax = SUM ( 'General Ledger'[vTaxAmount] )
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: General Ledger
		lineageTag: 81c96208-352e-469a-8748-906924066825

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

	/// Number of general ledger lines.
	measure Transactions = COUNTROWS ( 'General Ledger' )
		formatString: 0
		displayFolder: General Ledger
		lineageTag: bbcc2d65-4364-47eb-8ca2-1e956880d104

	/// Median line amount (VAT excl) of general ledger lines.
	measure 'Median Line Amount' = MEDIAN ( 'General Ledger'[vLineAmount] )
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: General Ledger
		lineageTag: e7eb2c6a-7e93-4328-82cb-69588d092131

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

	/// Number of distinct months that have general ledger lines.
	measure 'Months With Transactions' = COUNTROWS ( SUMMARIZE ( 'General Ledger', 'Date'[Calendar Month Key] ) )
		formatString: 0
		displayFolder: General Ledger
		lineageTag: bea8d664-a1d2-44bf-a74f-4b75f98846a5

	/// General ledger amount including VAT (line amount + tax). Intentionally VAT-inclusive; base measure for all GL time-intelligence measures.
	measure 'GL Amount' = [Total (VAT Incl)]
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: General Ledger
		lineageTag: 81c45caf-f737-446d-b557-a5720bd54f62

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

	/// Cumulative Total (VAT Incl) over the selected dates.
	measure 'Running Total (VAT Incl)' =

			CALCULATE(
				[Total (VAT Incl)],
				FILTER(
					ALLSELECTED('Date'[Date]),
					ISONORAFTER('Date'[Date], MAX('Date'[Date]), DESC)
				)
			)
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: General Ledger
		lineageTag: b9b44de8-ca38-47f4-ae85-15e95748982e

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "RunningTotal"
				}

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

	/// Archived: use the Time Intelligence calculation group instead.
	measure 'GL Amount YTD' =

			VAR AsOfDate = MAX ( 'Date'[Date] )
			VAR AsOfFiscalYear = MAX ( 'Date'[Fiscal Year] )
			RETURN
			    CALCULATE (
			        [GL Amount],
			        REMOVEFILTERS ( 'Date' ),
			        'Date'[Fiscal Year] = AsOfFiscalYear,
			        'Date'[Date] <= AsOfDate
			    )
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: Archive\General Ledger
		lineageTag: b1dfaf4e-dca0-4458-8135-30c29621f6a4

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

	/// Archived: use the Time Intelligence calculation group instead.
	measure 'GL Amount PY' = CALCULATE ( [GL Amount], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: Archive\General Ledger
		lineageTag: 73061422-92cd-4851-9c73-0e7c69524847

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

	/// Archived: use the Time Intelligence calculation group instead.
	measure 'GL Amount PM' = CALCULATE ( [GL Amount], DATEADD ( 'Date'[Date], -1, MONTH ) )
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: Archive\General Ledger
		lineageTag: b321351d-61e6-4f68-a54f-020134f7bc3d

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

	/// Archived: use the Time Intelligence calculation group instead.
	measure 'GL Amount YoY %' =

			VAR CurrentAmt = [GL Amount]
			VAR PriorAmt = [GL Amount PY]
			RETURN
			    DIVIDE ( CurrentAmt - PriorAmt, PriorAmt )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Archive\General Ledger
		lineageTag: 0aa446a0-e409-4fe2-85ed-43f8dafce57e

	/// Archived: use the Time Intelligence calculation group instead.
	measure 'GL Amount MoM %' =

			VAR CurrentAmt = [GL Amount]
			VAR PriorAmt = [GL Amount PM]
			RETURN
			    DIVIDE ( CurrentAmt - PriorAmt, PriorAmt )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Archive\General Ledger
		lineageTag: 67a99db0-e8fd-4464-a778-a61e058f02d5

	/// GL Amount for the current fiscal year up to the last completed fiscal month.
	measure 'GL Amount Comparable' =

			VAR ElapsedFiscalMonths =
			    CALCULATE (
			        MAX ( 'Date'[Fiscal Month Number] ),
			        'Date'[Is Fiscal Past Month] = TRUE (),
			        'Date'[Is Fiscal Current Year] = TRUE ()
			    )
			RETURN
			    CALCULATE (
			        [GL Amount],
			        'Date'[Fiscal Month Number] <= ElapsedFiscalMonths,
			        'Date'[Is Fiscal Current Year] = TRUE ()
			    )
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: General Ledger
		lineageTag: 4a178ff2-febb-4699-843b-27f9ad1728d0

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

	/// GL Amount for the previous fiscal year over the same number of fiscal months as GL Amount Comparable.
	measure 'GL Amount PY Comparable' =

			VAR ElapsedFiscalMonths =
			    CALCULATE (
			        MAX ( 'Date'[Fiscal Month Number] ),
			        'Date'[Is Fiscal Past Month] = TRUE (),
			        'Date'[Is Fiscal Current Year] = TRUE ()
			    )
			RETURN
			    CALCULATE (
			        [GL Amount],
			        'Date'[Fiscal Month Number] <= ElapsedFiscalMonths,
			        'Date'[Is Fiscal Previous Year] = TRUE ()
			    )
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: General Ledger
		lineageTag: 267550f8-05ff-4596-b59c-46efe23d2b00

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

	/// Actual amount from Budget vs Actual.
	measure Actual = SUM ( 'Budget vs Actual'[vActualAmount] )
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: Budget vs Actual
		lineageTag: 6f12353e-8269-4d34-a907-b5a2484cc4ef

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

	/// Budget amount.
	measure Budget = SUM ( 'Budget vs Actual'[vBudgetAmount] )
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: Budget vs Actual
		lineageTag: 00fd9914-2311-4a10-ad15-bf67cb21a838

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

	/// Forecast amount from Budget vs Actual (not the cash flow forecast).
	measure Forecast = SUM ( 'Budget vs Actual'[vForecastAmount] )
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: Budget vs Actual
		lineageTag: 123dadd5-def5-4ccd-be9e-1b6e431b6e7d

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

	/// Project amount from Budget vs Actual.
	measure Project = SUM ( 'Budget vs Actual'[vProjectAmount] )
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: Budget vs Actual
		lineageTag: c42e35c3-26ba-481b-a671-e97656669498

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

	/// Forecast minus Budget.
	measure 'Forecast Variance' = [Forecast] - [Budget]
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: Budget vs Actual
		lineageTag: b3e49f60-a4c6-4e80-aaa6-a3c41a7818f6

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

	/// Forecast Variance as a percentage of the absolute Budget. Blank when there is no budget.
	measure 'Forecast Variance %' = DIVIDE ( [Forecast Variance], ABS ( [Budget] ) )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Budget vs Actual
		lineageTag: 95afb788-ffbd-4986-8209-b888a90bfd13

	/// Archived: use the Time Intelligence calculation group instead.
	measure 'Actual YTD' =

			VAR AsOfDate = MAX ( 'Date'[Date] )
			VAR AsOfFiscalYear = MAX ( 'Date'[Fiscal Year] )
			RETURN
			    CALCULATE (
			        [Actual],
			        REMOVEFILTERS ( 'Date' ),
			        'Date'[Fiscal Year] = AsOfFiscalYear,
			        'Date'[Date] <= AsOfDate
			    )
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: Archive\Budget vs Actual
		lineageTag: f153fb4b-c290-4791-8cbb-1617bffbb07c

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

	/// Archived: use the Time Intelligence calculation group instead.
	measure 'Budget YTD' =

			VAR AsOfDate = MAX ( 'Date'[Date] )
			VAR AsOfFiscalYear = MAX ( 'Date'[Fiscal Year] )
			RETURN
			    CALCULATE (
			        [Budget],
