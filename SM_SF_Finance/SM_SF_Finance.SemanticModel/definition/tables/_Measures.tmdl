	/// Forecast from the last date in context to the end of that fiscal year.
	measure 'Forecast Remaining FY' =

			VAR AsOfDate = MAX ( 'Date'[Date] )
			VAR AsOfFiscalYear = MAX ( 'Date'[Fiscal Year] )
			RETURN
			    CALCULATE (
			        [Forecast],
			        REMOVEFILTERS ( 'Date' ),
			        'Date'[Fiscal Year] = AsOfFiscalYear,
			        'Date'[Date] >= AsOfDate
			    )
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: Budget vs Actual
		lineageTag: 6fa4ce56-8fbc-4b3e-8921-b8554bfff865

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

	/// Archived: use the Time Intelligence calculation group instead.
	measure 'Actual PY' = CALCULATE ( [Actual], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: Archive\Budget vs Actual
		lineageTag: f238cb50-c1b1-40e7-8614-62d503d035d1

