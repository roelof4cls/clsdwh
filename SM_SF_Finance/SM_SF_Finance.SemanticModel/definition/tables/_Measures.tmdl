	/// Archived: use the Time Intelligence calculation group instead.
	measure 'Forecast YoY %' = DIVIDE ( [Forecast YoY], [Forecast PY] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Archive\Budget vs Actual
		lineageTag: 0787677d-3e2e-438b-a224-726aa0cff0e6

	/// Sum of all balance rows in context: the fiscal-year opening BALANCE rows plus movements.
	measure 'Bank Transaction Amount' = SUM ( 'Bank Balance'[vTransactionAmount] )
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: Bank Balance
		lineageTag: 216088dd-e629-40de-9aa0-305ba4875b54

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

	/// Movements only, excluding the fiscal-year opening BALANCE rows.
	measure 'Bank Movement Amount' = CALCULATE ( [Bank Transaction Amount], 'Bank Balance'[Transaction Type] <> "BALANCE" )
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: Bank Balance
		lineageTag: a1a99168-6b80-47cb-9e09-2bc485b8767b

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

	/// Bank balance at the last date in context: the fiscal year's opening BALANCE row plus movements up to that date. Never later than the last balance transaction; blank for periods entirely after it.
	measure 'Closing Balance' =

			VAR LastTransactionDate =
			    CALCULATE ( MAXX ( 'Bank Balance', RELATED ( 'Date'[Date] ) ), REMOVEFILTERS ( 'Date' ) )
			VAR AsOfDate = MIN ( MAX ( 'Date'[Date] ), LastTransactionDate )
			VAR AsOfFiscalYear = LOOKUPVALUE ( 'Date'[Fiscal Year], 'Date'[Date], AsOfDate )
			RETURN
			    IF (
			        MIN ( 'Date'[Date] ) <= LastTransactionDate,
			        CALCULATE (
			            [Bank Transaction Amount],
			            REMOVEFILTERS ( 'Date' ),
			            'Date'[Fiscal Year] = AsOfFiscalYear,
			            'Date'[Date] <= AsOfDate
			        )
			    )
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: Bank Balance
		lineageTag: b13a440b-43c6-4444-a9ea-c181f201a5eb

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

	/// Closing Balance at the end of the month before the last date in context.
	measure 'Closing Balance PM' =

			VAR LastTransactionDate =
			    CALCULATE ( MAXX ( 'Bank Balance', RELATED ( 'Date'[Date] ) ), REMOVEFILTERS ( 'Date' ) )
			VAR AsOfDate = MIN ( MAX ( 'Date'[Date] ), LastTransactionDate )
			RETURN
			    CALCULATE (
			        [Closing Balance],
			        REMOVEFILTERS ( 'Date' ),
			        'Date'[Date] = EOMONTH ( AsOfDate, -1 )
			    )
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: Bank Balance
		lineageTag: 35a80dad-a4e0-42a0-ab94-0032343cc434

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

	/// Direction of Closing Balance compared with Closing Balance PM.
	measure 'Balance Trend MoM' =

			VAR CurrentBalance = [Closing Balance]
			VAR PriorBalance = [Closing Balance PM]
			RETURN
			    IF (
			        NOT ISBLANK ( CurrentBalance ),
			        SWITCH (
			            TRUE (),
			            CurrentBalance > PriorBalance, "▲ Up",
			            CurrentBalance < PriorBalance, "▼ Down",
			            "► Flat"
			        )
			    )
		displayFolder: Bank Balance
		lineageTag: 7abb7f45-be47-49d2-8ef4-9ab887268f2e

	/// Balance + forecast + safety net amounts.
	measure 'Cash Flow Total' = [Cash Flow Balance] + [Cash Flow Forecast Amount] + [Cash Flow Safety Net]
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: Cash Flow Forecast
		lineageTag: bb75455b-f653-4b8e-a468-c78fd947f1fe

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

	/// Archived: use the Time Intelligence calculation group instead.
	measure 'Cash Flow Total YTD' =

			VAR AsOfDate = MAX ( 'Date'[Date] )
			VAR AsOfFiscalYear = MAX ( 'Date'[Fiscal Year] )
			RETURN
			    CALCULATE (
			        [Cash Flow Total],
			        REMOVEFILTERS ( 'Date' ),
			        'Date'[Fiscal Year] = AsOfFiscalYear,
			        'Date'[Date] <= AsOfDate
			    )
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: Archive\Cash Flow Forecast
		lineageTag: de32dfab-838c-4810-92e0-cc9ad5b50dfe

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

	/// Forecast amount from the cash flow forecast.
	measure 'Cash Flow Forecast Amount' = SUM ( 'Cash Flow Forecast'[vForecastAmount] )
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: Cash Flow Forecast
		lineageTag: 037c39dc-88b4-4eb4-91ae-ead782e8b16a

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

	/// Balance amount from the cash flow forecast.
	measure 'Cash Flow Balance' = SUM ( 'Cash Flow Forecast'[vBalanceAmount] )
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: Cash Flow Forecast
		lineageTag: afc2c148-0170-4ef3-93f6-c87069324dac

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

	/// Safety net amount from the cash flow forecast.
	measure 'Cash Flow Safety Net' = SUM ( 'Cash Flow Forecast'[vSafetynetAmount] )
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: Cash Flow Forecast
		lineageTag: ae83ab2a-ab88-41b2-a39e-11a5575fcfb0

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

	/// Balance + forecast amounts, excluding the safety net.
	measure 'Cash Flow Total Excl Safety Net' = [Cash Flow Balance] + [Cash Flow Forecast Amount]
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: Cash Flow Forecast
		lineageTag: 8ca854f0-66e6-42f9-b784-2a894e10cafd

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

	/// Archived: use the Time Intelligence calculation group instead.
	measure 'Cash Flow Total Excl Safety Net YTD' =

			VAR AsOfDate = MAX ( 'Date'[Date] )
			VAR AsOfFiscalYear = MAX ( 'Date'[Fiscal Year] )
			RETURN
			    CALCULATE (
			        [Cash Flow Total Excl Safety Net],
			        REMOVEFILTERS ( 'Date' ),
			        'Date'[Fiscal Year] = AsOfFiscalYear,
			        'Date'[Date] <= AsOfDate
			    )
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: Archive\Cash Flow Forecast
		lineageTag: 0afb7194-8fe9-4117-8c9b-16afa4d6ddaf

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

