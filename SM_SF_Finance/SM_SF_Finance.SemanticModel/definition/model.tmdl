model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-ZA
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DIMENTITY","DIMDATE","DIMACCOUNT","DIMCONTACT","DIMBANKACCOUNT","FACTBALANCE","FACTBUDGETVSACTUAL","FACTGENERALLEDGER","FACTFORECAST"]

annotation PBI_ProTooling = ["DevMode"]

ref table DIMACCOUNT
ref table DIMBANKACCOUNT
ref table DIMCONTACT
ref table DIMDATE
ref table FACTBALANCE
ref table FACTBUDGETVSACTUAL
ref table FACTGENERALLEDGER
ref table DIMENTITY
ref table FACTFORECAST

ref cultureInfo en-US

