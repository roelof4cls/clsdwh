table FACTBUDGETVSACTUAL
	lineageTag: 35aa7f1d-2d15-4e87-b6c3-5ce9a3492ba9

	measure Actual = SUm(FACTBUDGETVSACTUAL[vActualAmount])
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: KPI
		lineageTag: 6f12353e-8269-4d34-a907-b5a2484cc4ef

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

	measure Budget = SUM(FACTBUDGETVSACTUAL[vBudgetAmount])
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: KPI
		lineageTag: 00fd9914-2311-4a10-ad15-bf67cb21a838

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

	measure Variance = [Forecast]-[Budget]
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: KPI
		lineageTag: b3e49f60-a4c6-4e80-aaa6-a3c41a7818f6

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

	measure 'Variance %' = ```
			
			VAR Actual = [Forecast]
			VAR Budget = [Budget]
			RETURN
			IF(
			    Budget = 0 || Actual = Budget,
			    0,
			    (Actual - Budget) / ABS(Budget)
			)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: KPI
		lineageTag: 95afb788-ffbd-4986-8209-b888a90bfd13

	measure Forecast = SUM(FACTBUDGETVSACTUAL[vForecastAmount])
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: KPI
		lineageTag: 123dadd5-def5-4ccd-be9e-1b6e431b6e7d

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

	measure 'Rolling Forecast FY' =
			
			CALCULATE (
			    [Forecast],
			    DATESYTD (
			        DimDate[Date],
			        "02-28"
			    )
			)
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: KPI
		lineageTag: 6b039215-318e-485f-b34f-468e91dbb906

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

	measure 'Rolling Budget FY' =
			
			CALCULATE (
			    [Budget],
			    DATESYTD (
			        DimDate[Date],
			        "02-28"
			    )
			)
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: KPI
		lineageTag: 59d1f05c-797e-4ab4-92a2-75fd83455abb

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

	measure 'Rolling Forecast' = ```
			
			CALCULATE (
			    [Forecast],
			    FILTER (
			        ALLEXCEPT ( 'DIMDATE', 'DIMDATE'[Fiscal Year Name]),
			        'DIMDATE'[Date]
			            >= MAX ( 'DIMDATE'[Date] )
			    )
			)
			
			```
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: KPI
		lineageTag: 6fa4ce56-8fbc-4b3e-8921-b8554bfff865

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "RunningTotal"
				}

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

	measure Project = SUM(FACTBUDGETVSACTUAL[vProjectAmount])
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: KPI
		lineageTag: c42e35c3-26ba-481b-a671-e97656669498

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

	measure 'Actual PY' = CALCULATE( [Actual],SAMEPERIODLASTYEAR(DIMDATE[Date]))
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: KPI\Prior Period
		lineageTag: f238cb50-c1b1-40e7-8614-62d503d035d1

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

	measure 'Budget PY' = CALCULATE( [Budget],SAMEPERIODLASTYEAR(DIMDATE[Date]))
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: KPI\Prior Period
		lineageTag: fe8b33ad-d8e8-45d5-a966-1114cde397b0

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

	measure 'Budget YoY Variance %' =
			
			VAR PY = [Budget PY]
			RETURN
			IF( PY =
			0
			||
			ISBLANK
			( PY ),
			BLANK
			(),
			DIVIDE
			( [Budget] - PY,
			ABS
			( PY ) ))
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: KPI\Prior Period
		lineageTag: f1c226a4-5cc7-4d71-8b33-ebd2d74e155e

	measure 'Rolling Actual FY' =
			
			CALCULATE (
			    [Actual],
			    DATESYTD (
			        DimDate[Date],
			        "02-28"
			    )
			)
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: KPI\Prior Period
		lineageTag: f153fb4b-c290-4791-8cbb-1617bffbb07c

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

	measure 'Forecast PFY' =
			
			CALCULATE(
			    SUM(FACTBUDGETVSACTUAL[vForecastAmount]),
			    SAMEPERIODLASTYEAR(DIMDATE[Date])
			)
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: KPI
		lineageTag: 032b2ba5-b74f-4d6b-a293-8eeb6047e67d

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

	measure 'Forecast YOY' = [Forecast]-[Forecast PFY]
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: KPI
		lineageTag: 101f918b-1c03-498a-8aa5-b630f5a5edcb

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

	measure 'Forecast YOY %' =
			
			DIVIDE(
			    [Forecast YOY],
			    [Forecast PFY],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: KPI
		lineageTag: 0787677d-3e2e-438b-a224-726aa0cff0e6

