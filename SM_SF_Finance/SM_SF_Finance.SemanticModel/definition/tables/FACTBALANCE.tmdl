table FACTBALANCE
	lineageTag: 30aa81bc-1693-48a0-9e2e-70b78fc466fe

	measure 'Transaction Amount' = ```
			SUM ( FACTBALANCE[vTransactionAmount])
			
			```
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: KPI
		lineageTag: 216088dd-e629-40de-9aa0-305ba4875b54

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

	measure 'Rolling Balance FY' = ```
			
			CALCULATE (
			    [Transaction Amount],
			    DATESYTD (
			        DimDate[Date],
			        "02-28"
			    )
			)
			
			```
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: KPI
		lineageTag: 65e79d55-f602-421b-82bd-759ed01a5946

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

	measure 'Balance Trend CM vs PM' = ```
			
			    SWITCH(
			        TRUE(),
			        [Balance Current Month] > [Balance Previous Month], "▲ Up",
			        [Balance Current Month] < [Balance Previous Month], "▼ Down",
			        "► Flat"
			    )
			```
		displayFolder: KPI
		lineageTag: 7abb7f45-be47-49d2-8ef4-9ab887268f2e

	measure 'Balance Previous Month' =
			
			VAR EndDate =
			    CALCULATE (
			        MAX ( DIMDATE[Date] ),
			        ALL ( DIMDATE ),
			        DIMDATE[Is Fiscal Previous Month] = TRUE ()
			    )
			RETURN
			    CALCULATE (
			        [Transaction Amount],
			        FILTER (
			            ALL ( DIMDATE ),
			            DIMDATE[Is Fiscal Current Year] = TRUE ()
			                && DIMDATE[Date] <= EndDate
			        )
			    )
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: KPI
		lineageTag: 35a80dad-a4e0-42a0-ab94-0032343cc434

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

	measure 'Balance Current Month' =
			
			VAR EndDate =
			    CALCULATE (
			        MAX ( DIMDATE[Date] ),
			        ALL ( DIMDATE ),
			        DIMDATE[Is Fiscal Current Month] = TRUE ()
			    )
			RETURN
			    CALCULATE (
			        [Transaction Amount],
			        FILTER (
			            ALL ( DIMDATE ),
			            DIMDATE[Is Fiscal Current Year] = TRUE ()
			                && DIMDATE[Date] <= EndDate
			        )
			    )
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: KPI
		lineageTag: 53c74db9-7043-464c-80f2-d3e9f1bf55cd

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

	measure 'Month End Balance' =
			
			VAR MonthEndDate =
			    MAX ( DIMDATE[Date] )
			RETURN
			    CALCULATE (
			        [Transaction Amount],
			        FILTER (
			            ALL ( DIMDATE ),
			            DIMDATE[Date] <= MonthEndDate
			                && DIMDATE[Fiscal Year]
			                    = MAX ( DIMDATE[Fiscal Year] )
			        )
			    )
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: KPI
		lineageTag: b13a440b-43c6-4444-a9ea-c181f201a5eb

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

	measure 'Movement Amount' = CALCULATE(SUM(FACTBALANCE[vTransactionAmount]),FACTBALANCE[Transaction Type]<>"BALANCE")
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		displayFolder: KPI
		lineageTag: a1a99168-6b80-47cb-9e09-2bc485b8767b

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

